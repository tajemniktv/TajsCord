{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TajsCord | Dev",
            "type": "shell",
            "command": "pnpm dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "TajsCord | Full build",
            "type": "shell",
            "command": "pnpm build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "TajsCord | Start",
            "type": "shell",
            "command": "pnpm start",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
